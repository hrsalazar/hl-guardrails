# Account being monitored (public address). Always read-only -- this tool never places,
# modifies, or cancels an order, and never needs a private key.
# The address is NOT kept here: set HLG_ACCOUNT (an Actions secret in CI) or put
# `account: '0x...'` in config.local.yaml, which is gitignored.
account: null

poll_seconds: 60
state_file: state.json

rules:
  risk_per_trade_pct: 1.0        # 3 x 1.0% = the 3% daily limit; % of the equity base: USDC collateral (unified) or perp equity (classic)
  max_positions: 3
  max_same_direction: 3          # the strategy is long-only with 3 slots
  max_gross_exposure_x: 3.0      # perp notional / base = HL's "Unified Account Leverage" when unified
  max_coin_exposure_x: 1.0       # net perp + spot in one coin vs the base (unified accounts only)
  max_leverage: 5                # isolated positions only (cross: account leverage is what counts)
  max_hold_days: 7
  daily_loss_limit_pct: 3.0      # whole account when unified, perps only when classic
  weekly_loss_limit_pct: 6.0
  allowed_coins: [BTC, ETH, SOL, NEAR, HYPE, XRP]
  no_add_underwater: true

scanner:
  strategy: breakout   # breakout (backtested, long-only) | pullback (legacy, tested negative)
  timeframes: [1d, 4h]  # breakout runs independently on each (both backtested, see README "Timeframe")
  coins: [BTC, ETH, SOL, NEAR, HYPE, XRP]
  # Macro/TradFi dashboard section, from HL's own tradfi perps (works from Actions, unlike FRED).
  # Dead listings are filtered by hlg.market. Context only - gates nothing.
  tradfi_coins: [xyz:SP500, xyz:GOLD, xyz:SILVER, xyz:CL, xyz:COPPER, xyz:NATGAS, xyz:EUR, xyz:JPY]
  interval_minutes: 30
  # 3-7d swing: daily trend (EMA20 vs EMA50) + 4h pullback (RSI) + proximity to 20d extreme
  rsi_long_max: 35
  rsi_short_min: 65
  level_proximity_pct: 3.0       # price within X% of 20-day high/low
  min_rr: 2.0
  prefer_short_when_funding_positive: true
  funding_carry_alert_apr: 20    # dashboard note if |annualised funding| > this % (never pushed)
  # fast heads-up for moves too quick for 1d/4h breakout levels to confirm - NOT backtested, no stop/size/target
  momentum_window_hours: 4
  momentum_alert_pct: 8          # alert if price moved more than this % within momentum_window_hours
  macro_context: false           # FRED backdrop on alerts/dashboard - context only, gates nothing.
                                 # Off by default: FRED times out from GitHub Actions. Fine locally.

# Flow section: recent liquidations from OKX (Hyperliquid publishes none). Recent events, not 24h
# totals. Time-boxed and fail-soft; the dashboard fetches OKX itself if this returns nothing.
flow:
  enabled: true
  liquidation_coins: [BTC, ETH, SOL]
  budget_s: 10

# Scheduled high-impact releases (FOMC, CPI, jobs...): pushed heads-up when one is within warn_hours.
events:
  enabled: true
  warn_hours: 24

# Daily AI brief of public macro/crypto headlines. Needs OPENROUTER_API_KEY or ANTHROPIC_API_KEY; skipped without either.
digest:
  enabled: true
  hour_utc: 6
  provider: auto
  openrouter_models: [anthropic/claude-opus-5.5, anthropic/claude-sonnet-5, openai/gpt-6-sol]
  model: claude-sonnet-5

telegram:
  enabled: false                 # set TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID env vars
