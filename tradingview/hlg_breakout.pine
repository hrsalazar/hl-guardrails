// This Pine Script® code is subject to the terms of the MIT licence (see the repo's LICENSE).
// HL Guardrails · the live breakout rule, as a TradingView indicator.
//
// Same maths as hlg/scanner.py and the backtest (README "Backtest"):
//   trend    EMA20 > EMA50 of the close                          (ta.ema == pandas ewm(span, adjust=False))
//   signal   a CLOSED bar closes above the highest high of the 20 bars before it
//   entry    the next bar's open -- skipped if it opens > 1 ATR above the signal close (don't chase)
//   stop     signal close - 2 x ATR14 (Wilder; ta.atr == the scanner's RMA ATR)
//   trail    3 x ATR below the highest high since entry, only ever raised
//   time     out at the close after 21 days
//   size     risk% of the equity base / (entry - stop); one trade at a time, NO adds
//
// Non-repainting: signals, entries and exits are decided on closed bars only. The live bar shows a
// "breaking out" status in the table but nothing is marked until the bar closes -- exactly like the
// monitor. Use it on the 1D and 4H charts (the two backtested timeframes), on the same perp you trade.
// Prices differ slightly between exchanges, so levels can differ by a tick from the Hyperliquid alert.
//
// Meant to be read at the decision point, not watched: set the alerts below and close the chart.
//@version=6
indicator("HL Guardrails · Breakout", shorttitle = "HLG Breakout", overlay = true, max_labels_count = 300, max_lines_count = 100)

// ── inputs ────────────────────────────────────────────────────────────────────────────────────────
grpR     = "Rule (as backtested — change only to explore)"
lenFast  = input.int(20, "Trend EMA fast", minval = 1, group = grpR)
lenSlow  = input.int(50, "Trend EMA slow", minval = 1, group = grpR)
lenHigh  = input.int(20, "Breakout: close above the high of the previous N bars", minval = 2, group = grpR)
lenAtr   = input.int(14, "ATR length (Wilder)", minval = 1, group = grpR)
stopAtr  = input.float(2.0, "Initial stop: ATR below the signal close", minval = 0.1, step = 0.1, group = grpR)
trailAtr = input.float(3.0, "Trailing stop: ATR below the highest high", minval = 0.1, step = 0.1, group = grpR)
maxDays  = input.int(21, "Time stop (days)", minval = 1, group = grpR)
chaseAtr = input.float(1.0, "Don't chase: skip if the entry opens more than N ATR above the signal close", minval = 0, step = 0.1, group = grpR)
nearAtr  = input.float(0.5, "'Near' zone: within N ATR below the level", minval = 0, step = 0.1, group = grpR)

grpS     = "Sizing"
equity   = input.float(10000, "Equity base (USDC collateral)", minval = 1, group = grpS)
riskPct  = input.float(1.0, "Risk per trade (%)", minval = 0.05, step = 0.05, group = grpS)

grpV     = "Display"
showEma  = input.bool(true, "EMA20 / EMA50", group = grpV)
showLvl  = input.bool(true, "Breakout level and 'near' zone", group = grpV)
showTbl  = input.bool(true, "Status table", group = grpV)
tblPos   = input.string(position.top_right, "Table position", options = [position.top_right, position.bottom_right, position.top_left, position.bottom_left], group = grpV)

// ── series ────────────────────────────────────────────────────────────────────────────────────────
emaF   = ta.ema(close, lenFast)
emaS   = ta.ema(close, lenSlow)
atrV   = ta.atr(lenAtr)
level  = ta.highest(high, lenHigh)[1]                    // the 20-bar high BEFORE this bar
up     = emaF > emaS
signal = up and close > level and not na(level) and not na(atrV)

// ── one trade at a time, decided on closed bars (historical bars are always closed) ──────────────
var int   st       = 0            // 0 flat · 1 signal closed, entry pending · 2 in a trade
var float sigClose = na
var float sigAtr   = na
var int   sigBar   = na
var float entry    = na
var float stop0    = na           // the initial stop: 1R = entry - stop0
var float stop     = na
var float best     = na
var int   entryBar = na
var int   nTrades  = 0
var int   nWins    = 0
var float sumR     = 0.0
timeStopBars = math.max(1, math.round(maxDays * 86400.0 / timeframe.in_seconds()))
fmt(x) => str.tostring(x, format.mintick)

if barstate.isconfirmed
    // 1) the bar after a signal: fill at its open, or skip a runaway open
    if st == 1 and bar_index == sigBar + 1
        if open > sigClose + chaseAtr * sigAtr
            label.new(bar_index, high, "ran > " + str.tostring(chaseAtr) + " ATR\nnot chased", style = label.style_label_down,
                      color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)
            st := 0
        else
            entry    := open
            stop0    := sigClose - stopAtr * sigAtr
            stop     := stop0
            best     := entry
            entryBar := bar_index
            st       := 2
    // 2) manage the open trade: stop first (gap -> filled at the open), then the time stop, then the trail
    if st == 2
        float exitPx = na
        string why   = ""
        if low <= stop
            exitPx := math.min(open, stop)
            why    := stop > stop0 ? "trail" : "stop"
        else if bar_index - entryBar >= timeStopBars
            exitPx := close
            why    := "time"
        else
            best := math.max(best, high)
            stop := math.max(stop, best - trailAtr * atrV)
        if not na(exitPx)
            r = (exitPx - entry) / (entry - stop0)
            nTrades += 1
            nWins   += r > 0 ? 1 : 0
            sumR    += r
            label.new(bar_index, high, "exit · " + why + "\n" + (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "R",
                      style = label.style_label_down, color = r >= 0 ? color.new(color.teal, 10) : color.new(color.red, 10),
                      textcolor = color.white, size = size.small)
            st := 0
    // 3) a signal on this closed bar
    if signal
        if st == 0
            sigClose := close
            sigAtr   := atrV
            sigBar   := bar_index
            st       := 1
            planStop = close - stopAtr * atrV
            qty      = equity * riskPct / 100 / (close - planStop)
            label.new(bar_index, low, "▲ BREAKOUT\nentry: next open\nstop " + fmt(planStop) + "\nsize ≈ " + str.tostring(qty, "#.####"),
                      style = label.style_label_up, color = color.new(color.green, 10), textcolor = color.white, size = size.small)
        else if st == 2
            label.new(bar_index, low, "held · don't add", style = label.style_label_up,
                      color = color.new(color.gray, 30), textcolor = color.white, size = size.tiny)

// ── plots ─────────────────────────────────────────────────────────────────────────────────────────
plot(showEma ? emaF : na, "EMA20", color.new(color.blue, 30), 1)
plot(showEma ? emaS : na, "EMA50", color.new(color.purple, 30), 1)
pLvl  = plot(showLvl ? level : na, "Breakout level (20-bar high)", up ? color.new(color.blue, 0) : color.new(color.gray, 50), 2, plot.style_stepline)
pNear = plot(showLvl and up ? level - nearAtr * atrV : na, "Near zone floor", color.new(color.blue, 85), 1, plot.style_stepline)
fill(pLvl, pNear, color = showLvl and up ? color.new(color.blue, 90) : na, title = "Near zone")
plot(st == 2 ? stop : na, "Stop / trail", color.new(color.red, 0), 2, plot.style_linebr)
plot(st == 2 ? entry : na, "Entry", color.new(color.gray, 40), 1, plot.style_linebr)

// ── alerts: set them, then close the chart ───────────────────────────────────────────────────────
alertcondition(signal and barstate.isconfirmed, "HLG breakout (bar closed)", "{{ticker}} {{interval}}: breakout closed above the 20-bar high. Entry next open, stop = close - 2 ATR.")
alertcondition(st == 2 and low <= stop, "HLG stop / trail touched", "{{ticker}} {{interval}}: the stop or trail was touched.")
if barstate.isconfirmed and signal and st == 1 and sigBar == bar_index
    alert(syminfo.ticker + " " + timeframe.period + ": BREAKOUT closed at " + fmt(close) + " > " + fmt(level) +
          ". Entry next open, stop " + fmt(close - stopAtr * atrV) + ", size ≈ " +
          str.tostring(equity * riskPct / 100 / (stopAtr * atrV), "#.####") + ". No adds.", alert.freq_once_per_bar_close)

// ── status table: what the monitor's scanner row would say ───────────────────────────────────────
if showTbl and barstate.islast
    var table t = table.new(tblPos, 2, 7, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 70))
    dist     = (level - close) / atrV
    status   = st == 2 ? "IN TRADE" : st == 1 ? "SIGNAL · enter at this bar's open (≤ 1 ATR above the signal close)" :
               signal and barstate.isconfirmed ? "SIGNAL · entry next open" :
               not up ? "Downtrend · not eligible" : close > level ? "BREAKING OUT · needs the close" :
               dist <= nearAtr ? "NEAR · " + str.tostring(dist, "#.##") + " ATR" : "Uptrend · " + str.tostring(dist, "#.#") + " ATR away"
    stCol    = st == 2 ? color.teal : st == 1 or signal ? color.green : not up ? color.gray : close > level ? color.orange : dist <= nearAtr ? color.blue : color.silver
    minsLeft = math.max(0, (time_close - timenow) / 60000)
    left     = minsLeft >= 60 ? str.tostring(math.floor(minsLeft / 60)) + "h " + str.tostring(math.floor(minsLeft % 60)) + "m" : str.tostring(math.floor(minsLeft)) + "m"
    isDay    = timeframe.isdaily
    base     = isDay ? "1D: 38% win · 56% reach +1R before the stop" : timeframe.period == "240" ? "4H: 35% win · 50% reach +1R before the stop" : "not a backtested timeframe"
    table.cell(t, 0, 0, "HLG Breakout", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, status, text_color = stCol, text_size = size.small)
    table.cell(t, 0, 1, "Level", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, fmt(level), text_color = color.white, text_size = size.small)
    table.cell(t, 0, 2, "Bar closes in", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, left + " · nothing signals before", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 3, st == 2 ? "Stop / trail" : "Stop if signal", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, fmt(st == 2 ? stop : close - stopAtr * atrV), text_color = color.white, text_size = size.small)
    table.cell(t, 0, 4, st == 2 ? "Open R" : "Size if signal", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, st == 2 ? str.tostring((close - entry) / (entry - stop0), "#.##") + "R" :
               str.tostring(equity * riskPct / 100 / (stopAtr * atrV), "#.####") + " (" + str.tostring(riskPct) + "% risk)",
               text_color = color.white, text_size = size.small)
    table.cell(t, 0, 5, "On this chart", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 5, str.tostring(nTrades) + " trades · " + (nTrades > 0 ? str.tostring(100.0 * nWins / nTrades, "#") + "% won · " + str.tostring(sumR / nTrades, "#.##") + "R avg" : "—"),
               text_color = color.white, text_size = size.small)
    table.cell(t, 0, 6, "Base rates", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 6, base + " · the edge is the ~20% that run", text_color = color.silver, text_size = size.small)
